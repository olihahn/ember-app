{
  "name": "ember-cigar-journal",
  "version": "0.1.0",
  "description": "A cigar journal for Android whose home screen is a painted 1960s travel poster you can lean into.",
  "license": "MIT",
  "keywords": [
    "android",
    "capacitor",
    "three.js",
    "multiplane",
    "parallax",
    "cigar",
    "journal"
  ],
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "postbuild": "node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:worker": "node scripts/check-worker-runtime.mjs",
    "icons": "node scripts/build-icons.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:apk": "npm run android:sync && node scripts/build-android.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/camera": "8.2.4",
    "@capacitor/core": "8.5.1",
    "@capacitor/geolocation": "8.2.2",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-geo": "3.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "0.186.0",
    "topojson-client": "3.1.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260907.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-geo": "3.1.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "esbuild": "0.28.1",
    "fake-indexeddb": "6.2.5",
    "miniflare": "5.20260907.0-alpha",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.35.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "type": "module",
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
