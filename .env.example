# Copy to .env for local web development. Server-side only: never prefix a
# secret with VITE_ or NEXT_PUBLIC_, or it ends up in the browser bundle.
# .env* is gitignored. See docs/BACKEND.md.

# ---------------------------------------------------------------------------
# Local web development
# ---------------------------------------------------------------------------

# Your OpenAI API Platform key. Only used by `npm run dev` on localhost.
OPENAI_API_KEY=

# The model the identification path asks for.
OPENAI_MODEL=gpt-4.1-mini

# Real provider calls cost money, so localhost stays mocked unless you opt in.
EMBER_ENABLE_AI=0

# ---------------------------------------------------------------------------
# Worker secrets — set with `wrangler secret put`, never written to a file
# ---------------------------------------------------------------------------
#
#   npx wrangler secret put OPENAI_API_KEY      --config wrangler.api.jsonc
#   npx wrangler secret put EMBER_DEVICE_TOKEN  --config wrangler.api.jsonc
#
# EMBER_DEVICE_TOKEN is the pairing token the phone sends as a bearer token.
# Generate a long random string, give the same value to the app under
# Settings -> Photo identification, and rotate it to revoke a lost device.
# The Worker refuses to serve until both of these exist.

# ---------------------------------------------------------------------------
# Deployment and QA scripts (scripts/hosted-backend-qa.mjs), macOS only
# ---------------------------------------------------------------------------
# Exported in your shell rather than committed. The pairing token itself lives
# in the macOS Keychain, not here.

# Cloudflare account that owns the Worker.
# CLOUDFLARE_ACCOUNT_ID=

# Worker name, which is also the Keychain account holding the pairing token.
# Defaults to ember-android-api.
# EMBER_WORKER_NAME=

# Where your deployed Worker answers.
# EMBER_SERVICE_ORIGIN=https://<your-worker>.workers.dev

# Exact device serial, required only to pair a physical phone.
# EMBER_PHONE_SERIAL=

# Names of the macOS Keychain items holding your secrets, so the scripts can
# read them without a value ever appearing in a file, an argument or a log.
# Choose your own names; nothing in this repository names a real one.
# EMBER_TOKEN_KEYCHAIN_SERVICE=
# EMBER_OPENAI_KEYCHAIN_SERVICE=
